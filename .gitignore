# Python caches / test outputs
__pycache__/
*.py[cod]
.pytest_cache/
pytest-of-root/
.coverage
.coverage.*
coverage.json
htmlcov/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# pip may materialize these roots beside the checkout when the host redirects
# its temporary directory. They are runtime state, never release inputs.
/pip-build-env-*/
/pip-build-tracker-*/
/pip-ephem-wheel-cache-*/
/pip-install-*/
/pip-metadata-*/
/pip-modern-metadata-*/
/pip-unpack-*/

# Virtual environments
.venv/
venv/

# Local environment / secrets
.env
.env.*
!.env.example

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Temporary / patch artifacts
*.tmp
*.temp
*.bak
*.orig
*.rej

# MQL5 native/generated outputs belong in release evidence/assets, not source control
*.ex5
*.log

# Local release-prep workspaces
_release-work/
release-work/
rc6-wheel-*/
docs/release/*/rc*-task*.xml
